# 生产 pnpm start 的端口；开发（pnpm dev / dev:server）已由 server package.json 强制 3001（cross-env 注入，dotenv 不覆盖已设 env），改这里不影响 dev
PORT=3000
JWT_SECRET=change-me

# 登录密码（明文；只在 .env 里自己用，勿进版本库）
PASSWORD=your-password-here
TOKEN_TTL=7d

# 终端守护进程 termd 的端口（仅 loopback，默认 3002）。chamber 拉起 termd 时显式传给它的 `--port`。
# 改了它，CLI（pnpm termd status/stop）要加同样的 `--port N` 才管得到同一个 termd。
# TERMD_PORT=3002

# 语音识别（按住说话）：阿里 DashScope 流式 asr（fun-asr-realtime），未配则按钮点了无响应
DASHSCOPE_API_KEY=

# 语音合成（朗读，可选）：默认 qwen-audio-3.0-tts-flash / longanlingxi / pcm@22050；
# 想换音色/模型/采样率才需要设（采样率改动会同步到前端 AudioContext，一般别动）
# TTS_MODEL=
# TTS_VOICE=
# TTS_SAMPLE_RATE=
# TTS_RATE=            # 语速 0.5~2.0，默认 1.0（前端朗读时也可调，设置项优先于此处）
